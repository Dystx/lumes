[Unit]
Description=Daily DB prune for lumes.pt
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/apps/lumes
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=/opt/apps/lumes/.env
# Use the HTTP cron endpoint (avoids shipping extra scripts into standalone output and keeps CRON_SECRET out of process list)
ExecStart=/usr/bin/curl -fsS -H "User-Agent: lumes-cron/1.0" -H "x-cron-secret: ${CRON_SECRET}" "http://127.0.0.1:3001/api/cron/prune"
TimeoutSec=600
Nice=10

[Install]
WantedBy=multi-user.target
