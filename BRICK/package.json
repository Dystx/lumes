{
  "name": "slop-audit",
  "version": "0.1.0",
  "description": "Detect AI-generated frontend slop",
  "type": "module",
  "bin": {
    "slop-audit": "bin/slop-audit.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "build:corpus": "tsx scripts/generate-corpus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "globby": "^14.0.0",
    "minimatch": "^9.0.5",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin",
    "corpus",
    "rules",
    "README.md",
    "LICENSE",
    "!dist/**/*.map"
  ],
  "keywords": [
    "ai",
    "slop",
    "frontend",
    "linter",
    "tailwind",
    "design-system",
    "react",
    "code-quality"
  ],
  "author": "Brick.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickdotdev/slop-audit.git"
  },
  "bugs": {
    "url": "https://github.com/brickdotdev/slop-audit/issues"
  },
  "homepage": "https://slop-audit.dev",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
